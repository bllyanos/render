<div class="mb-8">
    <h1 class="text-4xl mb-2">Dashboard</h1>
    {{#if query}}
        <p class="text-sm opacity-75">Showing results for <span class="meta-tag bg-stone-200 dark:bg-stone-800 ml-1">{{query}}</span></p>
    {{else}}
        <p class="text-sm opacity-75">All pages and documents</p>
    {{/if}}
</div>

<!-- Sorting Controls -->
<div class="mb-6">
    <div class="flex flex-wrap items-center gap-2 text-sm">
        <a href="/?sort=date_desc{{#if query}}&q={{query}}{{/if}}" 
           class="px-3 py-1 rounded-brutal border-2 border-stone-900 dark:border-stone-100 transition-all hover:translate-x-0.5 hover:-translate-y-0.5 {{#unless sortType}}bg-teal-400{{/unless}}{{#if sortType}}{{#ifeq sortType 'date_desc'}}bg-teal-400{{else}}bg-stone-100 dark:bg-stone-800{{/ifeq}}{{/if}}">
            Latest
        </a>
        <a href="/?sort=date_asc{{#if query}}&q={{query}}{{/if}}" 
           class="px-3 py-1 rounded-brutal border-2 border-stone-900 dark:border-stone-100 transition-all hover:translate-x-0.5 hover:-translate-y-0.5 {{#ifeq sortType 'date_asc'}}bg-teal-400{{else}}bg-stone-100 dark:bg-stone-800{{/ifeq}}">
            Oldest
        </a>
        <a href="/?sort=title_asc{{#if query}}&q={{query}}{{/if}}" 
           class="px-3 py-1 rounded-brutal border-2 border-stone-900 dark:border-stone-100 transition-all hover:translate-x-0.5 hover:-translate-y-0.5 {{#ifeq sortType 'title_asc'}}bg-teal-400{{else}}bg-stone-100 dark:bg-stone-800{{/ifeq}}">
            Title A-Z
        </a>
        <a href="/?sort=title_desc{{#if query}}&q={{query}}{{/if}}" 
           class="px-3 py-1 rounded-brutal border-2 border-stone-900 dark:border-stone-100 transition-all hover:translate-x-0.5 hover:-translate-y-0.5 {{#ifeq sortType 'title_desc'}}bg-teal-400{{else}}bg-stone-100 dark:bg-stone-800{{/ifeq}}">
            Title Z-A
        </a>
    </div>
</div>

<div class="space-y-4">
    {{#if pages.length}}
        {{#each pages}}
            <div class="content-box hover:translate-x-1 hover:-translate-y-1 transition-transform group">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl mb-1 group-hover:text-teal-700 dark:group-hover:text-teal-400">
                            <a href="/{{slug}}" class="no-underline">{{title}}</a>
                            {{#if priority}}
                                <span class="ml-2 text-[10px] bg-amber-400 text-stone-900 px-1.5 py-0.5 rounded-brutal font-bold uppercase tracking-wider inline-flex items-center gap-1">
                                    <i data-lucide="pin" class="w-2.5 h-2.5"></i>
                                    Pinned
                                </span>
                            {{/if}}
                        </h2>
                        {{#if description}}
                            <p class="text-sm mb-3 opacity-80">{{description}}</p>
                        {{/if}}
                        <div class="flex flex-wrap items-center gap-2">
                             <span class="meta-tag bg-white dark:bg-stone-800 text-[10px]">Doc</span>
                             {{#if tags}}
                                {{#each tags}}
                                    <span class="meta-tag {{tagColor this}} text-[10px]">{{this}}</span>
                                {{/each}}
                             {{/if}}
                        </div>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-bold opacity-50">
                        <i data-lucide="calendar" class="w-3 h-3"></i>
                        {{date}}
                    </div>
                </div>
            </div>
        {{/each}}
    {{else}}
        <div class="content-box text-center py-12 opacity-50">
            <i data-lucide="file-warning" class="w-12 h-12 mx-auto mb-4"></i>
            <p>No pages found matching your criteria.</p>
            <a href="/" class="text-sm underline">Clear search</a>
        </div>
    {{/if}}
</div>
