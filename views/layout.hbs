<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RENDER - {{title}}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ogUrl}}">
    <meta property="og:title" content="RENDER - {{title}}">
    {{#if description}}
    <meta property="og:description" content="{{description}}">
    {{/if}}
    <meta property="og:image" content="{{ogImage}}">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="{{ogUrl}}">
    <meta property="twitter:title" content="RENDER - {{title}}">
    {{#if description}}
    <meta property="twitter:description" content="{{description}}">
    {{/if}}
    <meta property="twitter:image" content="{{ogImage}}">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/css/main.css?k=131">
    <link rel="stylesheet" href="/hljs/styles/tokyo-night-dark.css">
</head>
<body class="p-4 md:p-12">

    <article class="max-w-3xl mx-auto">
        
        <!-- Header -->
        <header class="mb-10 pb-6 border-b-2 border-main flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <a href="/" class="text-2xl font-bold no-underline hover:text-teal-700 dark:hover:text-teal-400 transition-colors flex items-center gap-2">
                    <i data-lucide="box" class="w-8 h-8"></i>
                    RENDER
                </a>
            </div>
            <div class="w-full md:w-64">
                <form action="/" method="GET">
                    <div class="relative">
                        <input type="text" name="q" placeholder="Search..." value="{{query}}" class="search-input text-sm">
                        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2">
                            <i data-lucide="search" class="w-4 h-4 opacity-50"></i>
                        </button>
                    </div>
                </form>
            </div>
        </header>

        <!-- Main Content -->
        <main>
            {{{body}}}
        </main>

        <!-- Footer -->
        <footer class="mt-16 pt-8 border-t-2 border-main flex flex-col md:flex-row justify-between items-center gap-4 opacity-60">
            <div class="text-xs font-bold uppercase tracking-widest flex items-center gap-3">
                <a href="https://github.com/bllyanos/render" class="flex items-center gap-2 border-2 border-main px-2 py-1 rounded-md hover:bg-stone-200 dark:hover:bg-stone-800 transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none">
                    <i data-lucide="github" class="w-3 h-3"></i>
                    render
                </a>
                <span>made with &lt;3 by bllyanos.</span>
            </div>
            <div class="text-xs font-bold uppercase tracking-widest">
                &copy; 2026 render. All rights reserved.
            </div>
        </footer>

    </article>

    <script>
        lucide.createIcons({
            attrs: {
                'stroke-width': 2
            }
        });
    </script>
</body>
</html>
