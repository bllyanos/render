<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RENDER - {{title}}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ogUrl}}">
    <meta property="og:title" content="RENDER - {{title}}">
    {{#if description}}
    <meta property="og:description" content="{{description}}">
    {{/if}}
    <meta property="og:image" content="{{ogImage}}">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="{{ogUrl}}">
    <meta property="twitter:title" content="RENDER - {{title}}">
    {{#if description}}
    <meta property="twitter:description" content="{{description}}">
    {{/if}}
    <meta property="twitter:image" content="{{ogImage}}">

    <link rel="stylesheet" href="{{asset 'src/style.css'}}">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link id="hljs-theme" rel="stylesheet" href="/hljs/styles/tokyo-night-dark.css">
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'system';
            const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
</head>
<body class="p-4 md:p-12">

    <article class="max-w-3xl mx-auto">
        
        <!-- Header -->
        <header class="mb-10 pb-6 border-b-2 border-main flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <a href="/" class="text-2xl font-bold no-underline hover:text-teal-700 dark:hover:text-teal-400 transition-colors flex items-center gap-2">
                    <i data-lucide="box" class="w-8 h-8"></i>
                    RENDER
                </a>
            </div>
            <div class="w-full md:w-auto flex items-center justify-between md:justify-end gap-4">
                <div class="relative">
                    <button id="theme-toggle" class="border-2 border-main p-2 rounded-brutal bg-bg-surface shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all flex items-center justify-center" title="Toggle theme">
                        <i data-lucide="moon" class="w-5 h-5 hidden dark:block"></i>
                        <i data-lucide="sun" class="w-5 h-5 block dark:hidden"></i>
                    </button>
                    <div id="theme-menu" class="hidden absolute left-0 md:left-auto md:right-0 mt-2 w-32 border-2 border-main rounded-brutal bg-bg-surface shadow-brutal z-50 overflow-hidden">
                        <button data-theme="light" class="theme-menu-item w-full text-left px-4 py-2 text-sm font-bold hover:bg-teal-700 hover:text-white transition-colors flex items-center justify-between gap-2">
                            <span class="flex items-center gap-2"><i data-lucide="sun" class="w-4 h-4"></i> Light</span>
                            <i data-lucide="check" class="w-4 h-4 check-icon hidden"></i>
                        </button>
                        <button data-theme="dark" class="theme-menu-item w-full text-left px-4 py-2 text-sm font-bold hover:bg-teal-700 hover:text-white transition-colors border-t-2 border-main flex items-center justify-between gap-2">
                            <span class="flex items-center gap-2"><i data-lucide="moon" class="w-4 h-4"></i> Dark</span>
                            <i data-lucide="check" class="w-4 h-4 check-icon hidden"></i>
                        </button>
                        <button data-theme="system" class="theme-menu-item w-full text-left px-4 py-2 text-sm font-bold hover:bg-teal-700 hover:text-white transition-colors border-t-2 border-main flex items-center justify-between gap-2">
                            <span class="flex items-center gap-2"><i data-lucide="monitor" class="w-4 h-4"></i> System</span>
                            <i data-lucide="check" class="w-4 h-4 check-icon hidden"></i>
                        </button>
                    </div>
                </div>
                <div class="w-full md:w-64">
                    <form action="/" method="GET">
                        <div class="relative">
                            <input type="text" name="q" placeholder="Search..." value="{{query}}" class="search-input text-sm">
                            <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2">
                                <i data-lucide="search" class="w-4 h-4 opacity-50"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main>
            {{{body}}}
        </main>

        <!-- Footer -->
        <footer class="mt-16 pt-8 border-t-2 border-main flex flex-col md:flex-row justify-between items-center gap-4 opacity-60">
            <div class="text-xs font-bold uppercase tracking-widest flex items-center gap-3">
                <a href="https://github.com/bllyanos/render" class="flex items-center gap-2 border-2 border-main px-2 py-1 rounded-brutal hover:bg-stone-200 dark:hover:bg-stone-800 transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.1)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none">
                    <i data-lucide="github" class="w-3 h-3"></i>
                    render
                </a>
                <span>made with &lt;3 by bllyanos.</span>
            </div>
            <div class="text-xs font-bold uppercase tracking-widest">
                &copy; 2026 render. All rights reserved.
            </div>
        </footer>

    </article>

    <script>
        lucide.createIcons({
            attrs: {
                'stroke-width': 2
            }
        });

        // Theme Toggle Logic
        const themeToggle = document.getElementById('theme-toggle');
        const themeMenu = document.getElementById('theme-menu');
        const themeButtons = document.querySelectorAll('[data-theme]');

        themeToggle.addEventListener('click', () => {
            themeMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', (e) => {
            if (!themeToggle.contains(e.target) && !themeMenu.contains(e.target)) {
                themeMenu.classList.add('hidden');
            }
        });

        function setTheme(theme) {
            localStorage.setItem('theme', theme);
            const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            
            // Update active state in menu
            document.querySelectorAll('.theme-menu-item').forEach(item => {
                const check = item.querySelector('.check-icon');
                if (item.dataset.theme === theme) {
                    item.classList.add('bg-stone-100', 'dark:bg-stone-800');
                    if (check) check.classList.remove('hidden');
                } else {
                    item.classList.remove('bg-stone-100', 'dark:bg-stone-800');
                    if (check) check.classList.add('hidden');
                }
            });

            themeMenu.classList.add('hidden');
        }

        // Initialize menu active state
        setTheme(localStorage.getItem('theme') || 'system');

        themeButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                setTheme(btn.dataset.theme);
            });
        });

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            if (localStorage.getItem('theme') === 'system' || !localStorage.getItem('theme')) {
                if (e.matches) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            }
        });
    </script>
</body>
</html>
