<header class="mb-10 pb-10 border-b-2 border-black">
    <div class="mb-4 flex flex-wrap gap-2">
        {{#if tags}}
            {{#each tags}}
                <span class="meta-tag bg-white dark:bg-stone-800">{{this}}</span>
            {{/each}}
        {{/if}}
    </div>
    <h1 class="text-4xl md:text-5xl mb-4 leading-tight font-bold">
        {{title}}
    </h1>
    {{#if description}}
        <p class="text-xl opacity-75 font-normal">
            {{description}}
        </p>
    {{/if}}
    {{#if date}}
        <div class="mt-4 flex items-center gap-2 text-xs font-bold opacity-50 uppercase tracking-widest">
            <i data-lucide="calendar" class="w-3 h-3"></i>
            Published on {{date}}
        </div>
    {{/if}}
</header>

<div class="markdown-content">
    {{{content}}}
</div>

<footer class="mt-12 pt-8 border-t-2 border-black flex justify-between items-center opacity-60">
    <a href="/" class="text-xs font-bold uppercase tracking-widest flex items-center gap-2 no-underline hover:text-teal-700">
        <i data-lucide="arrow-left" class="w-3 h-3"></i>
        Back to Dashboard
    </a>
</footer>
