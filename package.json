{
  "name": "render",
  "version": "1.0.0",
  "description": "Render is a lightweight Node.js application designed to serve and display Markdown files with a clean, GitHub-inspired aesthetic. It features a dynamic dashboard and full-text search capabilities.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"nodemon app.js\" \"vite build --watch\"",
    "build": "vite build",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "cache:clear:all": "node scripts/clear-cache.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "fs-extra": "^11.3.3",
    "github-markdown-css": "^5.8.1",
    "gray-matter": "^4.0.3",
    "hbs": "^4.2.0",
    "highlight.js": "^11.11.1",
    "inquirer": "^8.2.7",
    "marked": "^17.0.1",
    "marked-gfm-heading-id": "^4.1.3",
    "marked-highlight": "^2.2.3",
    "redis": "^5.10.0",
    "satori": "^0.19.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.0.0",
    "vite": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bllyanos/render.git"
  },
  "bugs": {
    "url": "https://github.com/bllyanos/render/issues"
  },
  "homepage": "https://github.com/bllyanos/render#readme"
}
